# Base de datos
DATABASE_URL=sqlite:///./trading_journal.db
# Para PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/trading_journal

# Seguridad - CAMBIA ESTO EN PRODUCCIÓN
SECRET_KEY=change_me_with_a_long_random_string_in_production
ALGORITHM=HS256

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Aplicación
DEBUG=True
APP_NAME=Trading Journal API
APP_VERSION=1.0.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Uploads
UPLOAD_FOLDER=./instance/media/
